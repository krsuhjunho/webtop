#!/usr/bin/env python3
"""Fallback so VLC still starts when the desktop user is root.

The launcher calls geteuid() and exits when the result is 0. That symbol is
seven bytes, the same length as getppid. After the swap the check is true
only for pid 1. PUID=1000 is the real fix. This only covers a session that
was already started as root.
"""

from pathlib import Path

NAMES = ("vlc", "cvlc", "qvlc", "nvlc", "rvlc")


def main():
    bindir = Path("/usr/bin")
    for name in NAMES:
        path = bindir / name
        if not path.is_file() or path.is_symlink():
            continue
        data = path.read_bytes()
        if b"geteuid" not in data:
            print(f"{path}: no geteuid symbol")
            continue
        path.write_bytes(data.replace(b"geteuid", b"getppid"))
        print(f"patched {path}")


if __name__ == "__main__":
    main()
