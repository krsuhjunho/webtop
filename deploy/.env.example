# Copy to deploy/.env and fill in. Never commit deploy/.env.
# MaxMind GeoLite2 is free: https://www.maxmind.com/en/geolite2/signup
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# ISO 3166-1 alpha-2 codes, comma-separated. Private/LAN addresses are always allowed.
ALLOWED_COUNTRIES=KR,JP

# Hours between GeoLite2 downloads. 0 runs once and exits.
GEOIPUPDATE_FREQUENCY=72

# Host port for HTTPS. The container still listens on 443.
HTTPS_PORT=443
# Host port for the HTTP to HTTPS redirect. Empty disables publishing it.
HTTP_PORT=80

# Weekly cron: check (log only) or apply (pull and recreate when latest changed).
UPDATE_MODE=check
# Set to 1 to prune dangling webtop images after an applied update.
UPDATE_PRUNE=0

# Optional client PKCS#12 password used by scripts/gen-certs.sh (default changeit).
# P12_PASS=changeit
