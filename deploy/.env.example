# Copy to deploy/.env and fill in. Never commit deploy/.env.
# MaxMind GeoLite2 is free: https://www.maxmind.com/en/geolite2/signup
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# ISO 3166-1 alpha-2 codes, comma-separated. Private/LAN addresses are always allowed.
ALLOWED_COUNTRIES=KR,JP

# Hours between GeoLite2 downloads. 0 runs once and exits.
GEOIPUPDATE_FREQUENCY=72

# Host port for HTTPS. The container still listens on 443.
HTTPS_PORT=443
# Host port for the HTTP to HTTPS redirect. Empty disables publishing it.
HTTP_PORT=80

# Weekly cron: check (log only) or apply (pull and recreate when latest changed).
UPDATE_MODE=check
# Set to 1 to prune dangling webtop images after an applied update.
UPDATE_PRUNE=0

# Comma-separated client CNs that may open /admin/ in addition to OU=admin.
ADMIN_CNS=
# Shared by Nginx and certadmin. webtop.sh generates this if it is empty.
CERTADMIN_PROXY_SECRET=
# One-time enrollment links expire after this many seconds.
ENROLL_TTL_SECONDS=600

# Desktop variant. selkies is KDE on :latest. kasm is XFCE on :kasm.
# ./webtop.sh variant kasm
WEBTOP_VARIANT=selkies
# Moving tag pulled by update. variant rewrites latest/kasm. A pinned tag is kept.
IMAGE_TAG=latest
# Both variants are reached at webtop:3000. Kasm websockets stay on that port.
# WEBTOP_UPSTREAM=webtop:3000

# Desktop and stream profile: low-power, balanced, or quality.
# Selkies only. On the kasm variant, profile says so and does not change these.
# low-power: JPEG, 30 fps, CSS scaling, Brave without GPU raster. Audio stays on.
# ./webtop.sh profile low-power
WEBTOP_PROFILE=low-power
WEBTOP_BRAVE_LOW_CPU=1
SELKIES_ENCODER=jpeg
SELKIES_FRAMERATE=30
SELKIES_JPEG_QUALITY=55
SELKIES_VIDEO_CRF=32
SELKIES_USE_CPU=true
SELKIES_CPU_ENCODE_THREADING=true
SELKIES_VIDEO_STREAMING_MODE=false
SELKIES_USE_CSS_SCALING=true
SELKIES_SCALING_DPI=96
SELKIES_AUDIO_ENABLED=true

# Optional client PKCS#12 password used by scripts/gen-certs.sh (default changeit).
# P12_PASS=changeit
